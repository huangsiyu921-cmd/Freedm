<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only: lets the emulator reach the host-side Range test origin over plain
  HTTP (10.0.2.2). Release builds keep cleartext traffic disabled.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
